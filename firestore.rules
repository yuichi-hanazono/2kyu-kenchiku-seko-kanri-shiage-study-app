rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyAndAll(data, allowed, required) {
      return data.keys().hasOnly(allowed) && data.keys().hasAll(required);
    }

    function validUuid(value) {
      return value is string && value.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$');
    }

    function validDateKey(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function validIsoDateTime(value) {
      return value is string
        && value.size() <= 40
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]+)?(Z|[+-][0-9]{2}:[0-5][0-9])$');
    }

    function validEvent(userId, eventId) {
      let data = request.resource.data;
      let commonFields = ['schemaVersion', 'eventId', 'deviceId', 'questionId', 'occurredAt', 'kind'];
      return isOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId)/sync/manifest)
        && data.schemaVersion == 1
        && data.eventId == eventId
        && validUuid(data.eventId)
        && validUuid(data.deviceId)
        && data.questionId is string
        && data.questionId.size() > 0
        && data.questionId.size() <= 200
        && validIsoDateTime(data.occurredAt)
        && (
          (data.kind == 'first_study'
            && hasOnlyAndAll(data, commonFields + ['studiedOn', 'completedAt'], commonFields + ['studiedOn', 'completedAt'])
            && validDateKey(data.studiedOn) && validIsoDateTime(data.completedAt))
          || (data.kind == 'written_test'
            && hasOnlyAndAll(data, commonFields + ['studiedOn'], commonFields + ['studiedOn'])
            && validDateKey(data.studiedOn))
          || (data.kind == 'memory_rating'
            && hasOnlyAndAll(data, commonFields + ['studiedOn', 'countTest', 'rating', 'nextReviewOn'], commonFields + ['studiedOn', 'countTest', 'rating', 'nextReviewOn'])
            && validDateKey(data.studiedOn) && data.countTest is bool
            && data.rating in ['good', 'unsure', 'weak'] && validDateKey(data.nextReviewOn))
          || (data.kind == 'rating'
            && hasOnlyAndAll(data, commonFields + ['studiedOn', 'rating', 'nextReviewOn'], commonFields + ['studiedOn', 'rating', 'nextReviewOn'])
            && validDateKey(data.studiedOn) && data.rating in ['good', 'unsure', 'weak'] && validDateKey(data.nextReviewOn))
          || (data.kind == 'quiz_answer'
            && hasOnlyAndAll(data, commonFields + ['studiedOn', 'correct', 'rating', 'nextReviewOn'], commonFields + ['studiedOn', 'correct', 'rating', 'nextReviewOn'])
            && validDateKey(data.studiedOn) && data.correct is bool
            && data.rating in ['good', 'unsure', 'weak'] && validDateKey(data.nextReviewOn))
          || (data.kind == 'difficulty_set'
            && hasOnlyAndAll(data, commonFields + ['isDifficult'], commonFields + ['isDifficult'])
            && data.isDifficult is bool)
        );
    }

    match /users/{userId}/sync/manifest {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasOnlyAndAll(request.resource.data,
          ['schemaVersion', 'bankId', 'bankHash', 'storagePath', 'questionCount', 'updatedAt'],
          ['schemaVersion', 'bankId', 'bankHash', 'storagePath', 'questionCount', 'updatedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.bankId is string
        && request.resource.data.bankId.matches('^bank-[0-9a-f]{64}$')
        && request.resource.data.bankHash is string
        && request.resource.data.bankHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.bankId == 'bank-' + request.resource.data.bankHash
        && request.resource.data.storagePath == 'users/' + userId + '/banks/' + request.resource.data.bankId + '.json'
        && request.resource.data.questionCount is int
        && request.resource.data.questionCount > 0
        && request.resource.data.updatedAt is string
        && existsAfter(/databases/$(database)/documents/users/$(userId)/snapshots/initial)
        && getAfter(/databases/$(database)/documents/users/$(userId)/snapshots/initial).data.schemaVersion == 1
        && getAfter(/databases/$(database)/documents/users/$(userId)/snapshots/initial).data.bankId == request.resource.data.bankId
        && getAfter(/databases/$(database)/documents/users/$(userId)/snapshots/initial).data.bankHash == request.resource.data.bankHash;
      allow update, delete: if false;
    }

    match /users/{userId}/snapshots/{snapshotId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && snapshotId == 'initial'
        && existsAfter(/databases/$(database)/documents/users/$(userId)/sync/manifest)
        && getAfter(/databases/$(database)/documents/users/$(userId)/sync/manifest).data.bankId == request.resource.data.bankId
        && getAfter(/databases/$(database)/documents/users/$(userId)/sync/manifest).data.bankHash == request.resource.data.bankHash
        && hasOnlyAndAll(request.resource.data,
          ['schemaVersion', 'bankId', 'bankHash', 'deviceId', 'createdAt', 'progress'],
          ['schemaVersion', 'bankId', 'bankHash', 'deviceId', 'createdAt', 'progress'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.bankId is string
        && request.resource.data.bankHash is string
        && request.resource.data.deviceId is string
        && request.resource.data.createdAt is string
        && request.resource.data.progress is map
        && request.resource.data.progress.schemaVersion == 2
        && request.resource.data.progress.records is map;
      allow update, delete: if false;
    }

    match /users/{userId}/events/{eventId} {
      allow read: if isOwner(userId);
      allow create: if validEvent(userId, eventId);
      allow update, delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if false;
    }
  }
}
