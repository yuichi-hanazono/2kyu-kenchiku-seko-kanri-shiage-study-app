{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "教材問題レコード案",
  "description": "教材PDFから人が確認して登録する問題レコード。各記録にPDFページと抽出根拠を保持する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId",
    "reviewStatus",
    "questionText",
    "source"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "awaiting_confirmation",
        "verified",
        "rejected"
      ]
    },
    "questionText": {
      "type": "string",
      "description": "人が原本を確認して確定した問題文。取り込み時に推測で補完しない。"
    },
    "questionType": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "multiple_choice",
        "true_false",
        "short_answer",
        "calculation",
        null
      ]
    },
    "choices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choiceId",
          "text"
        ],
        "properties": {
          "choiceId": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "answer": {
      "type": [
        "string",
        "array",
        "number",
        "boolean",
        "null"
      ],
      "description": "原本または確認済み解答に根拠がある場合だけ設定する。"
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ],
      "description": "原本の解説または人が確認した説明。未確認の推測を入れない。"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document",
        "citations"
      ],
      "properties": {
        "document": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fileName",
            "sha256"
          ],
          "properties": {
            "fileName": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pdfPage",
              "role",
              "quote",
              "extractionMethod",
              "reviewStatus"
            ],
            "properties": {
              "pdfPage": {
                "type": "integer",
                "minimum": 1,
                "description": "PDF上のページ番号。1始まり。"
              },
              "printedPageLabel": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "教材に印刷されたページ表示。PDFページ番号とは別に保持する。"
              },
              "role": {
                "type": "string",
                "enum": [
                  "question",
                  "choice",
                  "answer",
                  "explanation",
                  "figure_or_table",
                  "other"
                ]
              },
              "quote": {
                "type": "string",
                "description": "該当ページから転記した根拠テキスト。図表の場合は位置や内容の確認メモも記録できる。"
              },
              "extractionMethod": {
                "type": "string",
                "enum": [
                  "pdfjs_text_layer",
                  "tesseract_js_ocr",
                  "manual_transcription"
                ]
              },
              "reviewStatus": {
                "type": "string",
                "enum": [
                  "awaiting_confirmation",
                  "verified"
                ]
              }
            }
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewStatus": {
            "const": "verified"
          }
        },
        "required": [
          "reviewStatus"
        ]
      },
      "then": {
        "properties": {
          "questionText": {
            "minLength": 1
          }
        }
      }
    }
  ]
}
